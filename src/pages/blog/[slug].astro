---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { getBlogPostBySlug } from '../../lib/queries';
import { estimateReadingMinutes, renderMarkdown } from '../../lib/markdown';
import { SITE_DEFAULTS } from '../../lib/site-config';

const { slug } = Astro.params;
const d1 = Astro.locals.runtime?.env?.DB;
const db = d1 ? getDb(d1) : null;

const post = slug ? await getBlogPostBySlug(db, slug) : null;
if (!post) {
  Astro.response.status = 404;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const articleHtml = post ? renderMarkdown(post.contentMarkdown) : '';
const readingMins = post ? estimateReadingMinutes(post.contentMarkdown) : 1;

const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.seoTitle || post.title,
      description: post.seoDescription || post.excerpt,
      image: post.coverUrl
        ? [
            post.coverUrl.startsWith('http')
              ? post.coverUrl
              : new URL(post.coverUrl, Astro.url.origin).toString(),
          ]
        : undefined,
      datePublished: post.publishedAt || post.updatedAt,
      dateModified: post.updatedAt,
      author: {
        '@type': 'Organization',
        name: SITE_DEFAULTS.fullTitle,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
    }
  : null;
---

<BaseLayout
  title={post ? `${post.seoTitle || post.title} — ${SITE_DEFAULTS.brandName}` : `Artículo no encontrado — ${SITE_DEFAULTS.brandName}`}
  description={post ? post.seoDescription || post.excerpt : SITE_DEFAULTS.description}
  ogImage={post?.coverUrl || undefined}
  ogType={post ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  {!post ? (
    <main class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
      <span class="rounded-full border border-ink/15 bg-white px-3 py-1 text-xs font-medium uppercase tracking-wider text-ink/60">
        404
      </span>
      <h1 class="mt-4 text-4xl font-medium tracking-tight">Artículo no encontrado</h1>
      <p class="mt-3 text-base text-ink/70">
        El artículo solicitado no existe o aún se encuentra en borrador.
      </p>
      <a
        href="/blog"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas hover:bg-accent-blue"
      >
        ← Volver al blog
      </a>
    </main>
  ) : (
    <article class="mx-auto max-w-3xl px-4 pt-8 pb-16 sm:px-6">
      <div class="mb-6">
        <a href="/blog" class="text-sm font-medium text-ink/60 hover:text-ink">
          ← Todos los artículos
        </a>
      </div>

      <header class="border-b border-ink/10 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink/60">
          {post.publishedAt && (
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('es-MX', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
          <span>·</span>
          <span>{readingMins} min de lectura</span>
        </div>

        <h1 class="mt-4 text-3xl font-medium leading-[1.1] tracking-tight text-ink sm:text-5xl">
          {post.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-ink/75">{post.excerpt}</p>
      </header>

      {post.coverUrl && (
        <figure class="my-8 overflow-hidden rounded-3xl border border-ink/12 bg-white">
          <img src={post.coverUrl} alt={post.title} class="w-full object-cover" />
        </figure>
      )}

      <div class="mt-8 text-base sm:text-lg" set:html={articleHtml} />
    </article>
  )}
</BaseLayout>
