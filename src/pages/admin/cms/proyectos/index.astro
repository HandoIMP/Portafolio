---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../db';
import { projects } from '../../../../db/schema';
import { asc, desc } from 'drizzle-orm';

const d1 = Astro.locals.runtime?.env?.DB;
type Project = typeof projects.$inferSelect;
let allProjects: Project[] = [];

if (d1) {
  const db = getDb(d1);
  try {
    allProjects = await db.select().from(projects).orderBy(asc(projects.sortOrder), desc(projects.id));
  } catch { /* empty */ }
}
---

<AdminLayout title="Proyectos" activeSection="proyectos">
  <div class="max-w-4xl">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-medium tracking-tight">Proyectos</h1>
        <p class="mt-1 text-sm text-ink/60">{allProjects.length} proyecto{allProjects.length !== 1 ? 's' : ''}</p>
      </div>
      <a
        href="/admin/cms/proyectos/new"
        class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-colors hover:bg-accent-blue"
      >
        + Nuevo proyecto
      </a>
    </div>

    {allProjects.length === 0 ? (
      <div class="mt-12 text-center text-sm text-ink/50">
        <p>Sin proyectos aún.</p>
      </div>
    ) : (
      <div class="mt-6 space-y-3">
        {allProjects.map((p) => (
          <a
            href={`/admin/cms/proyectos/${p.id}`}
            class="flex items-center gap-4 rounded-xl border border-ink/10 bg-white px-5 py-4 transition-shadow hover:shadow-md"
          >
            <div class="h-14 w-14 shrink-0 overflow-hidden rounded-lg bg-ink/5">
              {p.coverMediaUrl && (
                <img src={p.coverMediaUrl} alt="" class="h-full w-full object-cover" loading="lazy" />
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <p class="truncate font-medium">{p.title}</p>
                {!p.published && (
                  <span class="shrink-0 rounded bg-ink/8 px-1.5 py-0.5 text-xs text-ink/50">Borrador</span>
                )}
                {p.featured && (
                  <span class="shrink-0 rounded bg-accent-green/15 px-1.5 py-0.5 text-xs text-green-700">Destacado</span>
                )}
              </div>
              <p class="mt-0.5 text-sm text-ink/60">{p.client} · {p.year}</p>
            </div>
            <span class="text-xs text-ink/40">#{p.sortOrder}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
