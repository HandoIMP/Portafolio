---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db';
import { crmLeads } from '../../../db/schema';
import { desc, eq } from 'drizzle-orm';

const d1 = Astro.locals.runtime?.env?.DB;
const statusFilter = Astro.url.searchParams.get('status') || '';
const statuses = ['Nuevo', 'Contactado', 'En Propuesta', 'Cerrado', 'Descartado'] as const;

type Lead = typeof crmLeads.$inferSelect;
let leads: Lead[] = [];

if (d1) {
  const db = getDb(d1);
  try {
    if (statusFilter && statuses.includes(statusFilter as any)) {
      leads = await db
        .select()
        .from(crmLeads)
        .where(eq(crmLeads.status, statusFilter as any))
        .orderBy(desc(crmLeads.createdAt));
    } else {
      leads = await db.select().from(crmLeads).orderBy(desc(crmLeads.createdAt));
    }
  } catch {
    // empty
  }
}

const statusColors: Record<string, string> = {
  Nuevo: 'bg-accent-orange/15 text-accent-orange',
  Contactado: 'bg-accent-blue/15 text-accent-blue',
  'En Propuesta': 'bg-yellow-100 text-yellow-700',
  Cerrado: 'bg-accent-green/15 text-green-700',
  Descartado: 'bg-ink/8 text-ink/50',
};
---

<AdminLayout title="CRM / Leads" activeSection="crm">
  <div class="max-w-5xl">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-medium tracking-tight">Leads</h1>
        <p class="mt-1 text-sm text-ink/60">{leads.length} contacto{leads.length !== 1 ? 's' : ''}</p>
      </div>
    </div>

    <!-- Status filter tabs -->
    <div class="mt-6 flex flex-wrap gap-2">
      <a
        href="/admin/crm"
        class:list={[
          'rounded-full px-3 py-1.5 text-xs font-medium transition-colors',
          !statusFilter ? 'bg-ink text-canvas' : 'bg-ink/5 text-ink/70 hover:bg-ink/10',
        ]}
      >
        Todos
      </a>
      {statuses.map((s) => (
        <a
          href={`/admin/crm?status=${encodeURIComponent(s)}`}
          class:list={[
            'rounded-full px-3 py-1.5 text-xs font-medium transition-colors',
            statusFilter === s ? 'bg-ink text-canvas' : 'bg-ink/5 text-ink/70 hover:bg-ink/10',
          ]}
        >
          {s}
        </a>
      ))}
    </div>

    <!-- Lead list -->
    {leads.length === 0 ? (
      <div class="mt-12 text-center text-sm text-ink/50">
        <p>Sin leads {statusFilter ? `con estado "${statusFilter}"` : 'aún'}.</p>
      </div>
    ) : (
      <div class="mt-6 space-y-3">
        {leads.map((lead) => (
          <a
            href={`/admin/crm/${lead.id}`}
            class="block rounded-xl border border-ink/10 bg-white px-5 py-4 transition-shadow hover:shadow-md"
          >
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <p class="font-medium">{lead.name}</p>
                <p class="mt-0.5 text-sm text-ink/60">{lead.email}{lead.phone ? ` · ${lead.phone}` : ''}</p>
              </div>
              <span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', statusColors[lead.status] || 'bg-ink/8 text-ink/50']}>
                {lead.status}
              </span>
            </div>
            {lead.serviceInterest && (
              <p class="mt-2 text-xs text-ink/50">Servicio: {lead.serviceInterest}</p>
            )}
            <p class="mt-1 line-clamp-2 text-sm text-ink/70">{lead.message}</p>
            <p class="mt-2 text-xs text-ink/40">{new Date(lead.createdAt).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
