---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db';
import { crmLeads } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
const d1 = Astro.locals.runtime?.env?.DB;

if (!d1 || !id) return Astro.redirect('/admin/crm');

const db = getDb(d1);
const rows = await db.select().from(crmLeads).where(eq(crmLeads.id, Number(id))).limit(1);
const lead = rows[0];
if (!lead) return Astro.redirect('/admin/crm');

const statuses = ['Nuevo', 'Contactado', 'En Propuesta', 'Cerrado', 'Descartado'] as const;

const statusColors: Record<string, string> = {
  Nuevo: 'bg-accent-orange/15 text-accent-orange',
  Contactado: 'bg-accent-blue/15 text-accent-blue',
  'En Propuesta': 'bg-yellow-100 text-yellow-700',
  Cerrado: 'bg-accent-green/15 text-green-700',
  Descartado: 'bg-ink/8 text-ink/50',
};
---

<AdminLayout title={`Lead: ${lead.name}`} activeSection="crm">
  <div class="max-w-3xl">
    <a href="/admin/crm" class="inline-flex items-center gap-1 text-sm text-ink/60 hover:text-ink">
      ← Volver a Leads
    </a>

    <div class="mt-6 rounded-2xl border border-ink/10 bg-white p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-xl font-medium">{lead.name}</h1>
          <p class="mt-1 text-sm text-ink/60">{lead.email}</p>
          {lead.phone && <p class="text-sm text-ink/60">{lead.phone}</p>}
          {lead.company && <p class="text-sm text-ink/60">{lead.company}</p>}
        </div>
        <span class:list={['rounded-full px-3 py-1.5 text-xs font-medium', statusColors[lead.status] || 'bg-ink/8 text-ink/50']}>
          {lead.status}
        </span>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {lead.serviceInterest && (
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-ink/50">Servicio de interés</p>
            <p class="mt-1 text-sm">{lead.serviceInterest}</p>
          </div>
        )}
        {lead.budgetRange && (
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-ink/50">Rango de presupuesto</p>
            <p class="mt-1 text-sm">{lead.budgetRange}</p>
          </div>
        )}
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-ink/50">Página fuente</p>
          <p class="mt-1 text-sm">{lead.sourcePage}</p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-ink/50">Fecha</p>
          <p class="mt-1 text-sm">{new Date(lead.createdAt).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</p>
        </div>
      </div>

      <div class="mt-6 border-t border-ink/10 pt-4">
        <p class="text-xs font-medium uppercase tracking-wider text-ink/50">Mensaje</p>
        <p class="mt-2 whitespace-pre-wrap text-sm leading-relaxed">{lead.message}</p>
      </div>
    </div>

    <!-- Status changer + Notes -->
    <form id="lead-form" class="mt-6 rounded-2xl border border-ink/10 bg-white p-6 space-y-4">
      <h2 class="text-sm font-medium">Gestión interna</h2>

      <div>
        <label for="status" class="block text-xs font-medium uppercase tracking-wider text-ink/50">Estado</label>
        <select
          id="status"
          name="status"
          class="mt-2 w-full rounded-xl border border-ink/15 bg-canvas px-4 py-3 text-sm focus:border-accent-blue focus:outline-none"
        >
          {statuses.map((s) => (
            <option value={s} selected={lead.status === s}>{s}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="notes" class="block text-xs font-medium uppercase tracking-wider text-ink/50">Notas internas</label>
        <textarea
          id="notes"
          name="notes"
          rows="4"
          class="mt-2 w-full rounded-xl border border-ink/15 bg-canvas px-4 py-3 text-sm focus:border-accent-blue focus:outline-none"
          placeholder="Notas privadas sobre este lead..."
        >{lead.internalNotes}</textarea>
      </div>

      <div class="flex items-center justify-between">
        <p id="save-msg" class="text-sm text-accent-green hidden">Guardado ✓</p>
        <button
          type="submit"
          class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition-colors hover:bg-accent-blue disabled:opacity-50"
        >
          Guardar cambios
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ leadId: lead.id }}>
    const form = document.getElementById('lead-form');
    const msg = document.getElementById('save-msg');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const res = await fetch(`/api/admin/leads/${leadId}`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            status: fd.get('status'),
            internalNotes: fd.get('notes'),
          }),
        });
        if (res.ok && msg) {
          msg.classList.remove('hidden');
          setTimeout(() => msg.classList.add('hidden'), 2000);
        }
      });
    }
  </script>
</AdminLayout>
