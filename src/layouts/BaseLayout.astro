---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_DEFAULTS } from '../lib/site-config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  showFooterCta?: boolean;
  activeNav?: 'trabajo' | 'equipo' | 'servicios' | 'contacto' | 'none';
  jsonLd?: Record<string, unknown> | null;
}

const {
  title = SITE_DEFAULTS.fullTitle,
  description = SITE_DEFAULTS.description,
  ogImage = '/projects/hcconstruccion/cover.webp',
  ogType = 'website',
  noindex = false,
  showFooterCta = true,
  activeNav = 'none',
  jsonLd = null,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.url.origin).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href="/fonts/general-sans/GeneralSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/boska/Boska-VariableItalic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/brand/logo-imp.svg" type="image/svg+xml" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-canvas text-ink font-sans antialiased">
    <Navbar activeNav={activeNav} />
    <div class="pt-20 sm:pt-24">
      <slot />
    </div>
    <Footer showCta={showFooterCta} />
  </body>
</html>
